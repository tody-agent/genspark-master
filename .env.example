# Genspark CLI Configuration
# Default model to use when --model is not specified
GENSPARK_DEFAULT_MODEL=claude-opus-4-7

# Browser mode: headed (visible) or headless
GENSPARK_HEADLESS=false

# Port for OpenAI-compatible proxy server
GENSPARK_SERVER_PORT=8080

# Session directory for cookies/state
GENSPARK_SESSION_DIR=~/.genspark

# Enable search web feature in Genspark
GENSPARK_ENABLE_SEARCH=true
